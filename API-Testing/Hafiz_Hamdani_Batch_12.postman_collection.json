				{
					"name": "GET All Users",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is valid\", () => {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
									"});",
									"",
									"pm.test(\"Response time < 2s\", () => {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});",
									"",
									"pm.test(\"Response has valid Content-Type\", () => {",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"",
									"const res = pm.response.json();",
									"",
									"const schema = {",
									"    type: \"object\",",
									"    required: [\"page\", \"per_page\", \"total\", \"total_pages\", \"data\"],",
									"    properties: {",
									"        page: { type: \"number\" },",
									"        per_page: { type: \"number\" },",
									"        total: { type: \"number\" },",
									"        total_pages: { type: \"number\" },",
									"        data: {",
									"            type: \"array\",",
									"            items: {",
									"                type: \"object\",",
									"                required: [\"id\", \"email\", \"first_name\", \"last_name\", \"avatar\"],",
									"                properties: {",
									"                    id: { type: \"number\" },",
									"                    email: { type: \"string\", pattern: \"^\\\\S+@\\\\S+\\\\.\\\\S+$\" },",
									"                    first_name: { type: \"string\" },",
									"                    last_name: { type: \"string\" },",
									"                    avatar: { type: \"string\" }",
									"                }",
									"            }",
									"        },",
									"        support: {",
									"            type: \"object\",",
									"            properties: {",
									"                url: { type: \"string\" },",
									"                text: { type: \"string\" }",
									"            }",
									"        }",
									"    }",
									"};",
									"",
									"pm.test(\"Response matches JSON schema\", function () {",
									"    pm.expect(tv4.validate(res, schema), tv4.error).to.be.true;",
									"});",
									"",
									"pm.test(\"Data array is not empty\", () => {",
									"    pm.expect(res.data).to.be.an('array').that.is.not.empty;",
									"});",
									"",
									"pm.test(\"Each user has valid email format\", () => {",
									"    res.data.forEach(user => {",
									"        pm.expect(user.email).to.match(/^\\S+@\\S+\\.\\S+$/);",
									"    });",
									"});",
									"",
									"pm.test(\"Each user object contains required fields\", () => {",
									"    res.data.forEach(user => {",
									"        pm.expect(user).to.have.all.keys(\"id\", \"email\", \"first_name\", \"last_name\", \"avatar\");",
									"    });",
									"});",
									"",
									"pm.test(\"Page number and total pages are valid numbers\", () => {",
									"    pm.expect(res.page).to.be.a(\"number\");",
									"    pm.expect(res.total_pages).to.be.at.least(1);",
									"});",
									"",
									"pm.test(\"Support section contains valid information\", () => {",
									"    pm.expect(res.support).to.be.an(\"object\");",
									"    pm.expect(res.support.url).to.be.a(\"string\");",
									"    pm.expect(res.support.text).to.be.a(\"string\");",
									"});",
									"",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
